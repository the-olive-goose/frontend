# Tells the app it is live: enables HSTS, stops error responses leaking stack
# traces, and stops signup OTP codes being returned in the API response when email
# delivery fails. Railway does NOT set this for you — set it explicitly.
NODE_ENV=production

# PostgreSQL connection string — provided automatically by Railway
DATABASE_URL=postgresql://user:password@host:port/dbname

# The storefront's public address (e.g. https://theolivegoose.ie). Used for CORS,
# and as the base for links we send people to (OAuth returns, Stripe return URLs,
# order + password-reset emails). Comma-separate to allow extra origins through
# CORS (apex + www, a staging domain); the first entry is the canonical one.
FRONTEND_URL=https://your-frontend-url.com

# Public base for URLs the BROWSER is redirected to mid-auth: the OAuth
# redirect_uri, and uploaded-media links.
#
# Set this to the SAME SITE as FRONTEND_URL — normally FRONTEND_URL itself, not the
# *.up.railway.app hostname. The storefront proxies /api/* through to this service
# (see public/_redirects), so https://theolivegoose.ie/api/auth/google/callback
# reaches here fine, and the session cookie the callback sets then lands on the
# storefront's own domain. Point it at the raw Railway hostname instead and social
# sign-in breaks twice over: Google rejects the unregistered redirect_uri with
# "Access blocked", and even once registered the session cookie is set on
# railway.app, where the shop can't use it. The server warns about this at boot.
BACKEND_URL=https://your-frontend-url.com

# Strong random secret for signing JWTs
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Admin login credentials — only used to bootstrap the `admins` table on the
# very first boot (see initDb() in index.js). Once that row exists, the admin
# password lives in the database and is changed via the admin password-reset
# flow (POST /api/auth/admin/password/forgot then /reset) — editing these
# env vars afterwards has no effect on an existing deployment.
ADMIN_EMAIL=admin@yourdomain.com

# bcrypt hash of your admin password (used only for that first-boot bootstrap)
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$examplehashhere

# ── Email (Resend) — verification codes for signup ─────────────────────────────
# Without RESEND_API_KEY the signup OTP runs in dev mode: the code is logged and
# returned in the API response instead of being emailed.
# Get a key at https://resend.com → API Keys. FROM_EMAIL must use a verified
# domain; until you verify one you can use the shared onboarding@resend.dev sender.
RESEND_API_KEY=
FROM_EMAIL=The Olive Goose <onboarding@resend.dev>

# ── Stripe (online checkout) ────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY, checkout returns "Online payments are not configured
# yet." Get test keys at https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhooks/stripe endpoint. In local dev, run
# `stripe listen --forward-to localhost:3001/api/webhooks/stripe` and use the
# whsec_... it prints. In production, create a webhook endpoint in the Stripe
# Dashboard pointed at https://your-backend-url.com/api/webhooks/stripe (event:
# checkout.session.completed) and use its signing secret.
# Optional in dev — checkout still completes via the success-page fallback poll
# (GET /api/checkout/session/:id) even without this set, but the webhook is the
# reliable source of truth and should be configured before going live.
STRIPE_WEBHOOK_SECRET=

# ── Optional integrations (features stay disabled until these are set) ──────────

# Google OAuth login — https://console.cloud.google.com/auth/clients
# The credential's "Authorized redirect URIs" must contain, exactly:
#   <BACKEND_URL>/api/auth/google/callback
# Anything else and Google answers with "Access blocked: This app's request is
# invalid (Error 400: redirect_uri_mismatch)" before the user can even pick an
# account. ("Authorized JavaScript origins" is NOT used — this is the server-side
# authorization-code flow, so no browser-side Google SDK ever calls Google.)
# The consent screen must also be Published, not in Testing, or only listed test
# users can sign in. Scopes here are only openid/email/profile, which are
# non-sensitive, so publishing needs no Google verification review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth login — https://developers.facebook.com/apps
# Valid OAuth Redirect URI: <BACKEND_URL>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twilio SMS for phone OTP login. Without these, OTP runs in dev mode and the
# code is returned in the API response instead of being texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Frontend build-time var ────────────────────────────────────────────────────
# VITE_API_URL is DEV-ONLY and must NOT be set in the Netlify/Vercel build
# environment. A production build always calls /api on its own origin and relies on
# the proxy in public/_redirects; see src/lib/apiBase.ts for why (short version:
# an absolute cross-site API URL turns the session cookie into a third-party
# cookie, so login succeeds and then the next request 401s). Setting it in a
# production build now has no effect — delete it rather than leaving it to confuse
# the next person.

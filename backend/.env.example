# PostgreSQL connection string — provided automatically by Railway
DATABASE_URL=postgresql://user:password@host:port/dbname

# Your deployed frontend URL (e.g. https://the-olive-goose.up.railway.app)
# Used for OAuth redirects and CORS.
FRONTEND_URL=https://your-frontend-url.com

# Public URL of THIS backend. Used to build OAuth callback URLs and absolute
# video upload URLs. On a single Railway service this is the same as FRONTEND_URL.
BACKEND_URL=https://your-backend-url.com

# Strong random secret for signing JWTs
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Admin login credentials
ADMIN_EMAIL=admin@yourdomain.com

# bcrypt hash of your admin password
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$examplehashhere

# ── Email (Resend) — verification codes for signup ─────────────────────────────
# Without RESEND_API_KEY the signup OTP runs in dev mode: the code is logged and
# returned in the API response instead of being emailed.
# Get a key at https://resend.com → API Keys. FROM_EMAIL must use a verified
# domain; until you verify one you can use the shared onboarding@resend.dev sender.
RESEND_API_KEY=
FROM_EMAIL=The Olive Goose <onboarding@resend.dev>

# ── Optional integrations (features stay disabled until these are set) ──────────

# Google OAuth login — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth login — https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twilio SMS for phone OTP login. Without these, OTP runs in dev mode and the
# code is returned in the API response instead of being texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Frontend build-time var (set in the ROOT service, not backend) ─────────────
# Leave UNSET for a single same-origin Railway deploy. Only set this if the
# frontend is hosted separately from the backend (e.g. Vercel + Railway).
# VITE_API_URL=https://your-backend-url.com
